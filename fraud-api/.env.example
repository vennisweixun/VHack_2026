# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local MongoDB (default — no authentication)
MONGODB_URL=mongodb://localhost:27017
# MongoDB Atlas (cloud) example:
# MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB_NAME=fraudshield

# ─── Fraud Detection Model ────────────────────────────────────────────────────
# Leave blank to use the built-in mock scoring model.
# Set this to your real model's HTTP endpoint when ready.
# The API will POST transaction data and expect: { "fraud_probability": 0.87 }
FRAUD_MODEL_URL=
FRAUD_MODEL_API_KEY=

# ─── Risk Classification Thresholds ──────────────────────────────────────────
# fraud_score < APPROVED_THRESHOLD          → APPROVED
# APPROVED_THRESHOLD <= score < BLOCK_THRESHOLD → FLAGGED
# fraud_score >= BLOCK_THRESHOLD            → BLOCKED
APPROVED_THRESHOLD=0.40
BLOCK_THRESHOLD=0.75

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
API_PREFIX=/api/v1
